# RouteOpt configuration (copy to .env and adjust). No secrets are needed anywhere.

# OSRM routing server (docker/osrm). When it is not responding RouteOpt falls back to
# straight-line estimates and shows a persistent banner.
OSRM_URL=http://localhost:5000

# Database. Default: SQLite file at data/routeopt.db (zero setup).
# Postgres example:   postgresql+psycopg://user:pass@host:5432/routeopt
# SQL Server example: mssql+pyodbc://user:pass@host/routeopt?driver=ODBC+Driver+18+for+SQL+Server
#ROUTEOPT_DB_URL=

# Where uploads, exports and the SQLite file live (default: ./data)
#ROUTEOPT_DATA_DIR=data

# Logging level for the JSON-ish log lines (DEBUG, INFO, WARNING)
#ROUTEOPT_LOG_LEVEL=INFO

# OSRM table limit (must match --max-table-size of osrm-routed) and request timeout
#OSRM_MAX_TABLE_SIZE=2000
#OSRM_TIMEOUT_S=20

# Map embedding on the Results page: html (default, fixed height) or st_folium
#ROUTEOPT_MAP_COMPONENT=html
